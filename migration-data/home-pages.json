    "ourStory": {
      "subtitle": "About Us",
      "title": "Advancing Cyber-Physical Systems for Societal Impact",
      "description": "The CyPSi Lab, established in 1999 at the Institute of Informatics and Communication (IIC) of University of Delhi has contributed to a wide range of domains from Educational Technologies, to scientific research papers and to Cyber Physical Systems (CPS)\n\n",
      "timelinePoints": [
        {
          "title": "Research Expansion",
          "description": "The lab expanded into educational technologies, applied computing, and interdisciplinary research, producing high-quality academic publications.",
          "id": "6939bb9e9300902a2e3cf63d"
        },
        {
          "title": "Focus on CPS",
          "description": "Dedicated research in Cyber-Physical Systems integrated computation, communication, and physical processes for real-life solutions.",
          "id": "6939bbdf9300902a2e3cf63f"
        }
      ],
      "buttonText": "Learn More About Us",
      "buttonLink": "/about",
      "campusImage": "6939bc8b9e483c7b9b8b6326",
      "missionVisionCards": [
        {
          "title": "Our Mission",
          "description": "To lead research in Cyber-Physical Systems and allied disciplines, addressing real-world challenges through innovation.",
          "id": "6939bcae9300902a2e3cf643"
        },
        {
          "title": "Our Vision",
          "description": "To be a globally recognized lab connecting academia, industry, and society through scalable, impactful research solutions.",
          "id": "6939bcbf9300902a2e3cf645"
        }
      ],
      "coreValues": []
