              },
              {
                "type": "listitem",
                "indent": 0,
                "value": 3,
                "children": [
                  {
                    "type": "paragraph",
                    "children": [
                      {
                        "type": "text",
                        "text": "Transfer learning and meta-learning"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "heading",
            "tag": "h3",
            "children": [
              {
                "type": "text",
                "text": "2.2 Natural Language Processing"
